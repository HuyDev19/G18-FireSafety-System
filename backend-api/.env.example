# ==============================================================================
# G1.8 FIRE SAFETY SYSTEM (PCCC) - BACKEND API ENVIRONMENT VARIABLES
# ==============================================================================

# 1. KẾT NỐI CLOUD POSTGRESQL + POSTGIS (Dùng chung cho cả 5 thành viên)
# LƯU Ý BẮT BUỘC: 
# - Chạy lệnh SQL: "CREATE EXTENSION IF NOT EXISTS postgis;" trên SQL Editor của Cloud DB.
# - Luôn có tham số "?sslmode=require" ở cuối chuỗi kết nối.
#
# Mẫu Supabase (Port 5432 Direct / Session Mode):
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
#
# Mẫu Neon:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require"

# 2. CẤU HÌNH SERVER NESTJS
PORT=3000
NODE_ENV=development

# 3. BẢO MẬT & XÁC THỰC JWT (FR-01 - Role 3 cấu hình)
JWT_SECRET=g18_pccc_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=g18_pccc_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# 4. LƯU TRỮ HỒ SƠ ĐIỆN TỬ & ẢNH MINH CHỨNG (FR-08 - MinIO / S3 - Role 4 cấu hình)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_NAME=pccc-documents
