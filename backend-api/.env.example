# Cấu hình kết nối PostgreSQL + PostGIS (Dùng Docker local hoặc Neon/Supabase Cloud)
# Format Local: postgresql://admin_pccc:password123@localhost:5432/g18_fire_safety_db?schema=public
# Format Cloud: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://admin_pccc:password123@localhost:5432/g18_fire_safety_db?schema=public"

# Cổng khởi chạy Backend API
PORT=3000

# Secret Key cho JWT Authentication (Role 3 cấu hình)
JWT_SECRET=super_secret_jwt_key_pccc_g18
JWT_EXPIRES_IN=1d

# Cấu hình MinIO / S3 Storage (Role 4 cấu hình)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_NAME=pccc-documents
