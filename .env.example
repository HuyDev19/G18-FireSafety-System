# ==============================================================================
# HỆ THỐNG QUẢN LÝ AN TOÀN PHÒNG CHÁY CHỮA CHÁY (G1.8 PCCC) - BIẾN MÔI TRƯỜNG MẪU
# ==============================================================================

# 1. Cơ sở dữ liệu PostgreSQL + PostGIS (Cổng 5432)
# Local Docker: postgresql://admin_pccc:password123@localhost:5432/g18_fire_safety_db?schema=public
# Cloud (Neon/Supabase): postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://admin_pccc:password123@localhost:5432/g18_fire_safety_db?schema=public"

# 2. Cấu hình Backend API (NestJS)
PORT=3000
NODE_ENV=development

# 3. Bảo mật Xác thực JWT (FR-01)
JWT_SECRET="g18_pccc_jwt_secret_key_change_me_in_production"
JWT_EXPIRES_IN="1d"

# 4. Lưu trữ Object Storage (MinIO / S3 - FR-08)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minio_admin"
MINIO_SECRET_KEY="password123"
MINIO_BUCKET_NAME="pccc-documents"

# 5. Cấu hình Frontend Web Client (React 18 + Vite)
VITE_API_BASE_URL="http://localhost:3000/api"
