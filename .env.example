# ==============================================================================
# HỆ THỐNG QUẢN LÝ AN TOÀN PHÒNG CHÁY CHỮA CHÁY (G1.8 PCCC) - BIẾN MÔI TRƯỜNG MẪU
# ==============================================================================

# 1. Cơ sở dữ liệu Cloud PostgreSQL + PostGIS (Dùng chung cho cả 5 Roles)
# Yêu cầu: Đã bật "CREATE EXTENSION IF NOT EXISTS postgis;" trên Cloud DB SQL Editor
# Mẫu Supabase (Port 5432 Direct Mode):
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
# Mẫu Neon:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require"

# 2. Cấu hình Backend API (NestJS)
PORT=3000
NODE_ENV=development

# 3. Bảo mật Xác thực JWT (FR-01)
JWT_SECRET="g18_pccc_jwt_secret_key_change_me_in_production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="g18_pccc_jwt_refresh_secret_key"
JWT_REFRESH_EXPIRES_IN="7d"

# 4. Lưu trữ Object Storage (MinIO / S3 - FR-08)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minio_admin"
MINIO_SECRET_KEY="password123"
MINIO_BUCKET_NAME="pccc-documents"

# 5. Cấu hình Frontend Web Client (React 18 + Vite)
VITE_API_BASE_URL="http://localhost:3000/api"
